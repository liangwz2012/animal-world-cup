{
  "name": "rural-football-3d",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Clean-room 3D rural football game for WeChat Mini Game",
  "packageManager": "npm@11.8.0",
  "scripts": {
    "bootstrap": "node tools/fetch-layaair.mjs",
    "build:assets:m0": "node tools/build-m0-assets.mjs",
    "check": "npm run check:scaffold && npm run verify:toolchain && npm run typecheck && npm test",
    "check:m0": "npm run bootstrap && npm run build:assets:m0 && npm run check",
    "check:scaffold": "node tools/check-scaffold.mjs",
    "verify:toolchain": "node tools/verify-toolchain.mjs",
    "generate:replay": "tsx tools/generate-m0-replay.ts",
    "verify:assets:m0": "node tools/verify-m0-gltf.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=24.13.1 <25",
    "npm": "11.8.0"
  },
  "dependencies": {
    "@galacean/engine": "1.6.13"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "tsx": "4.23.2",
    "typescript": "5.9.3"
  }
}

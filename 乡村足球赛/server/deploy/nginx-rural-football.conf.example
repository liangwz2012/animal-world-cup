# `limit_*_zone` 与 `upstream` 段放入 Nginx 的 `http {}`；下方三个
# `location` 段放入 coaiz.com 已有的 HTTPS `server {}`。证书由现有站点统一管理。
# 三个 Node 服务只监听 127.0.0.1，不直接暴露公网端口。

limit_req_zone $binary_remote_addr zone=rural_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=rural_api:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=rural_socket:10m;

upstream rural_friend {
  server 127.0.0.1:8787;
  keepalive 32;
}

upstream rural_rank {
  server 127.0.0.1:8788;
  keepalive 16;
}

upstream rural_config {
  server 127.0.0.1:8789;
  keepalive 4;
}

# 放入现有 `server { listen 443 ssl http2; server_name coaiz.com; ... }` 内：
location = /rural-football/config/v1 {
  limit_req zone=rural_api burst=10 nodelay;
  proxy_pass http://rural_config/v1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_connect_timeout 3s;
  proxy_read_timeout 5s;
}

location ^~ /rural-rank/ {
  client_max_body_size 32k;
  limit_req zone=rural_api burst=20 nodelay;
  proxy_pass http://rural_rank/;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_connect_timeout 3s;
  proxy_read_timeout 10s;
}

location = /rural-ws {
  client_max_body_size 300k;
  limit_conn rural_socket 8;
  proxy_pass http://rural_friend;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_connect_timeout 5s;
  proxy_read_timeout 75s;
  proxy_send_timeout 15s;
}

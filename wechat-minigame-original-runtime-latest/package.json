{
  "name": "animal-football-original-runtime-latest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node tools/build.mjs",
    "verify": "node tools/verify.mjs",
    "test:game-options": "node tools/test-game-options.mjs",
    "test:touch": "node tools/test-touch.mjs",
    "test:controls-ui": "node tools/test-controls-ui.mjs",
    "test:game-shell": "node tools/test-game-shell.mjs",
    "test:match-chrome-input": "node tools/test-match-chrome-input.mjs",
    "test:platform": "node tools/test-platform.mjs",
    "test:critical-textures": "node tools/test-critical-textures.mjs && node tools/test-critical-textures-retry.mjs",
    "test:friend-invite": "node tools/test-friend-invite.mjs && node tools/test-friend-service-config.mjs",
    "test:friend-input": "node tools/test-friend-input-sampler.mjs",
    "test:room-client": "node tools/test-room-client.mjs",
    "test:friend-server": "node tools/test-friend-room-server.mjs",
    "test:match-sync": "node tools/test-match-sync.mjs",
    "test:friend-flow": "node tools/test-friend-match-coordinator.mjs",
    "test:remote-config": "node tools/test-remote-config.mjs",
    "server": "node server/friend-room-server.mjs",
    "server:dev": "DEV_AUTH=1 HOST=127.0.0.1 PORT=18787 node server/friend-room-server.mjs",
    "check": "npm run build && npm run verify && npm run test:game-options && npm run test:touch && npm run test:controls-ui && npm run test:game-shell && npm run test:match-chrome-input && npm run test:platform && npm run test:critical-textures && npm run test:friend-invite && npm run test:friend-input && npm run test:room-client && npm run test:friend-server && npm run test:match-sync && npm run test:friend-flow && npm run test:remote-config",
    "release:check": "npm run check && node tools/release-check.mjs"
  },
  "dependencies": {
    "ws": "^8.20.0"
  }
}
